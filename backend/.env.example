NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/Imovies
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
SEAT_LOCK_MINUTES=10
CANCELLATION_CUTOFF_HOURS=2

# Optional Stripe Checkout. Booking checkout returns 503 until these are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional SMTP booking notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional first administrator created by the seed script.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Movie Admin
